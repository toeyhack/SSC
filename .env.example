# Example environment variables for local development

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ssc
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me
SSC_API_ENABLED=false
SSC_API_TOKEN=
# Dedicated workers may point to a protected JSON manifest. The path itself is
# not an EXTERNAL_PUBLIC attestation; absent/invalid manifests fail closed.
SCANNER_VANTAGE_MANIFEST_PATH=
